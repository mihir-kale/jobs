{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobDescriptionCompetencyMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_identity",
    "role_summary",
    "hard_qualifications",
    "tier_1_terms",
    "tier_2_competencies",
    "behavioral_competencies",
    "ambiguities"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "job_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "title", "locations", "employment_type", "program_term", "seniority"],
      "properties": {
        "company": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "locations": { "type": "array", "items": { "type": "string" } },
        "employment_type": { "type": ["string", "null"] },
        "program_term": { "type": ["string", "null"] },
        "seniority": { "enum": ["internship", "entry_level", "experienced", "leadership", "unspecified"] }
      }
    },
    "role_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_mandate", "business_outcomes"],
      "properties": {
        "primary_mandate": { "type": "string" },
        "business_outcomes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hard_qualifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "requirement", "level", "resume_visibility", "evidence_quote"],
        "properties": {
          "category": { "enum": ["enrollment", "degree", "major", "graduation_date", "gpa", "work_authorization", "location", "travel", "clearance", "age", "availability", "experience", "credential", "other"] },
          "requirement": { "type": "string" },
          "level": { "enum": ["required", "preferred"] },
          "resume_visibility": { "enum": ["must_show_if_supported", "helpful_if_supported", "application_only"] },
          "evidence_quote": { "type": "string" }
        }
      }
    },
    "tier_1_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_term", "exact_terms", "category", "level", "evidence_quotes"],
        "properties": {
          "canonical_term": { "type": "string" },
          "exact_terms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "category": { "enum": ["programming_language", "framework_library", "ai_data", "cloud", "database", "development_tool", "analytical_tool", "software_platform", "methodology", "credential", "technical_terminology", "other"] },
          "level": { "enum": ["required", "preferred", "responsibility", "mentioned"] },
          "evidence_quotes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tier_2_competencies": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competency_id", "rank", "competency", "category", "score", "exact_jd_phrases", "evidence_quotes", "resume_evidence_sought"],
        "properties": {
          "competency_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
          "rank": { "type": "integer", "minimum": 1 },
          "competency": { "type": "string" },
          "category": { "enum": ["responsibility", "method", "deliverable", "role_function", "stakeholder_activity", "domain_terminology"] },
          "score": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_status", "repetition", "centrality", "specificity", "total"],
            "properties": {
              "required_status": { "enum": [0, 1, 2, 3] },
              "repetition": { "enum": [0, 1, 2] },
              "centrality": { "enum": [0, 1, 2, 3] },
              "specificity": { "enum": [0, 1, 2] },
              "total": { "type": "integer", "minimum": 0 }
            }
          },
          "exact_jd_phrases": { "type": "array", "items": { "type": "string" } },
          "evidence_quotes": { "type": "array", "items": { "type": "string" } },
          "resume_evidence_sought": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "enum": ["award", "adopted_product", "financial_impact", "operational_improvement", "scale_or_usage", "technical_implementation", "analysis", "recommendation", "leadership", "communication", "domain_experience"] }
          }
        }
      }
    },
    "behavioral_competencies": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competency", "level", "evidence_quote"],
        "properties": {
          "competency": { "type": "string" },
          "level": { "enum": ["required", "preferred", "emphasized", "mentioned"] },
          "evidence_quote": { "type": "string" }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "evidence_quotes"],
        "properties": {
          "issue": { "type": "string" },
          "evidence_quotes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}