{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceMatch",
  "description": "Deterministic output of the evidence matcher. Maps a Phase-1 JD competency map to ranked candidate facts, skills, competency coverage, hard-qualification verdicts, uncovered competencies, and a redundancy signature. Contains only match bookkeeping (scores/components/tags) and references to evidence-bank IDs; it never mutates or restates prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_for",
    "summary",
    "fact_scores",
    "skill_matches",
    "competency_coverage",
    "behavioral_coverage",
    "hard_qualifications",
    "uncovered",
    "redundancy",
    "determinism"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_for": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "title", "program_term", "competency_map_schema_version"],
      "properties": {
        "company": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "program_term": { "type": ["string", "null"] },
        "competency_map_schema_version": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strong_matches",
        "moderate_matches",
        "weak_or_none",
        "verified_requested_skills",
        "unsupported_requested_skills",
        "high_priority_uncovered_competencies"
      ],
      "properties": {
        "strong_matches": { "type": "integer", "minimum": 0 },
        "moderate_matches": { "type": "integer", "minimum": 0 },
        "weak_or_none": { "type": "integer", "minimum": 0 },
        "verified_requested_skills": { "type": "array", "items": { "type": "string" } },
        "unsupported_requested_skills": { "type": "array", "items": { "type": "string" } },
        "high_priority_uncovered_competencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fact_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id", "entry_id", "total_score", "bucket", "score_components",
          "matched_competencies", "matched_skills", "matched_behavioral", "metrics"
        ],
        "properties": {
          "fact_id": { "type": "string" },
          "entry_id": { "type": "string" },
          "total_score": { "type": "number" },
          "bucket": { "enum": ["strong", "moderate", "weak", "none"] },
          "score_components": {
            "type": "object",
            "additionalProperties": false,
            "required": ["competency", "tier1_skill", "evidence_sought", "evidence_strength", "metric", "behavioral", "domain"],
            "properties": {
              "competency": { "type": "number" },
              "tier1_skill": { "type": "number" },
              "evidence_sought": { "type": "number" },
              "evidence_strength": { "type": "number" },
              "metric": { "type": "number" },
              "behavioral": { "type": "number" },
              "domain": { "type": "number" }
            }
          },
          "matched_competencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["competency_id", "rank", "match_coefficient", "weight", "requested_evidence_satisfied"],
              "properties": {
                "competency_id": { "type": "string" },
                "rank": { "type": "integer" },
                "match_coefficient": { "type": "number" },
                "weight": { "type": "number" },
                "requested_evidence_satisfied": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "matched_skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonical_term", "level", "skill_id"],
              "properties": {
                "canonical_term": { "type": "string" },
                "level": { "type": "string" },
                "skill_id": { "type": "string" }
              }
            }
          },
          "matched_behavioral": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["competency", "level", "tag"],
              "properties": {
                "competency": { "type": "string" },
                "level": { "type": "string" },
                "tag": { "type": "string" }
              }
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric_id", "value", "status"],
              "properties": {
                "metric_id": { "type": "string" },
                "value": { "type": "string" },
                "status": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "skill_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_term", "level", "category", "status", "skill_id", "proficiency", "verified"],
        "properties": {
          "canonical_term": { "type": "string" },
          "level": { "type": "string" },
          "category": { "type": "string" },
          "status": { "enum": ["supported", "unsupported", "not_in_bank"] },
          "skill_id": { "type": ["string", "null"] },
          "proficiency": { "type": ["integer", "null"] },
          "verified": { "type": ["boolean", "null"] }
        }
      }
    },
    "competency_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competency_id", "rank", "weight", "status", "best_fact_id", "best_match"],
        "properties": {
          "competency_id": { "type": "string" },
          "rank": { "type": "integer" },
          "weight": { "type": "number" },
          "status": { "enum": ["covered", "partial", "uncovered"] },
          "best_fact_id": { "type": ["string", "null"] },
          "best_match": { "type": "number" }
        }
      }
    },
    "behavioral_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competency", "level", "tag", "matched_fact_ids"],
        "properties": {
          "competency": { "type": "string" },
          "level": { "type": "string" },
          "tag": { "type": ["string", "null"] },
          "matched_fact_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "hard_qualifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "requirement", "level", "resume_visibility", "verdict", "basis"],
        "properties": {
          "category": { "type": "string" },
          "requirement": { "type": "string" },
          "level": { "enum": ["required", "preferred"] },
          "resume_visibility": { "type": "string" },
          "verdict": { "enum": ["met", "not_met", "unknown", "not_machine_verifiable"] },
          "basis": { "type": "string" }
        }
      }
    },
    "uncovered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competency_id", "rank", "weight", "reasons"],
        "properties": {
          "competency_id": { "type": "string" },
          "rank": { "type": "integer" },
          "weight": { "type": "number" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "redundancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature", "pairs"],
      "properties": {
        "signature": { "type": "string" },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_a", "fact_b", "shared_competencies", "jaccard", "dominant_fact_id"],
            "properties": {
              "fact_a": { "type": "string" },
              "fact_b": { "type": "string" },
              "shared_competencies": { "type": "array", "items": { "type": "string" } },
              "jaccard": { "type": "number" },
              "dominant_fact_id": { "type": "string" }
            }
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_hash"],
      "properties": {
        "input_hash": { "type": "string" }
      }
    }
  }
}