{
  "schema_version": "1.0",
  "target": "resume_planner",
  "planner_version": "1.0.0",
  "description": "Every tunable number for the deterministic resume planner. Nothing is hardcoded in resume_planner.py. Section budgets encode the observed preferred format from the existing renderer content JSONs (experience up to 2 entries / 6 bullets / 4 per entry; leadership up to 2 entries / 5 bullets / 3 per entry; additional 2 lines). No LLM, no Supabase, no resume assembly at this stage; the output is a plan IR.",
  "sections": {
    "experience": {
      "prior": 1.0,
      "max_entries": 2,
      "max_total_bullets": 6,
      "min_bullets_per_entry": 1,
      "max_bullets_per_entry": 4
    },
    "leadership": {
      "prior": 0.75,
      "max_entries": 2,
      "max_total_bullets": 5,
      "min_bullets_per_entry": 1,
      "max_bullets_per_entry": 3
    }
  },
  "additional": {
    "max_lines": 2
  },
  "evidence_strength_max": 5,
  "tier1_level_factors": {
    "required": 1.0,
    "preferred": 0.8,
    "responsibility": 0.6,
    "mentioned": 0.4
  },
  "metric_status_factors": {
    "realized": 1.0,
    "implemented": 1.0,
    "ongoing": 1.0,
    "identified": 0.5,
    "estimated": 0.5,
    "potential": 0.3,
    "recommended": 0.3
  },
  "decimal_precision": 4,
  "entry_scoring": {
    "top_fact": 1.0,
    "second_fact": 0.7,
    "third_fact": 0.45,
    "quality_bonus_per_quantified_fact": 0.05,
    "quality_bonus_quantified_cap": 2,
    "award_bonus": 0.1,
    "role_family_bonus_per_high_priority": 0.1,
    "unique_coverage_bonus_per_competency": 0.1,
    "high_priority_min_weight": 0.4,
    "strong_coefficient": 0.5,
    "min_entry_score": 0.0
  },
  "marginal_selection": {
    "weights": {
      "competency_coverage": 1.0,
      "skill_coverage": 0.6,
      "evidence_quality": 0.5,
      "metric": 0.4,
      "differentiation": 0.3
    },
    "coverage_level_thresholds": {
      "strong": 0.5,
      "moderate": 0.3,
      "weak": 0.0
    },
    "coverage_saturation": {
      "none": 0.0,
      "weak": 0.4,
      "moderate": 0.7,
      "strong": 0.9,
      "saturated": 1.0
    },
    "redundancy_penalties": {
      "moderate": { "min_jaccard": 0.6, "penalty": 0.15 },
      "strong": { "min_jaccard": 0.8, "penalty": 0.35 }
    },
    "differentiation": {
      "distinct_domain_bonus": 0.05,
      "distinct_metric_bonus": 0.05
    },
    "min_positive_marginal": 0.0,
    "swap_min_improvement": 0.05,
    "swap_passes": 2
  },
  "future_fact": {
    "tie_priority": ["completed", "in_progress", "planned"]
  },
  "coverage_targets": {
    "high": { "min_weight": 0.4, "min_level": "strong" },
    "medium": { "min_weight": 0.2, "min_level": "moderate" },
    "low": { "min_weight": 0.0, "min_level": "none" }
  },
  "coverage_loss_guard": {
    "min_weight": 0.4,
    "candidate_min_level": "strong",
    "max_acceptable_selected_level": "weak"
  },
  "unsupported_gap_min_weight": 0.4,
  "skills": {
    "max_selected": 14,
    "evidence_cap": 5,
    "evidence_weight": 0.2,
    "requested_supported_multiplier": 1.0,
    "requested_unsupported_excluded": true,
    "differentiator_multiplier": 0.55,
    "selected_fact_boost": 1.2,
    "category_order": ["technical", "analytical", "platform", "tool", "business", "methodology", "communication"]
  },
  "education": {
    "max_entries": 2,
    "locked_details_always": true,
    "optional_detail_relevance": { "enabled": true }
  },
  "bullet": {
    "max_primary_competencies": 2,
    "max_secondary_competencies": 2,
    "max_target_terms": 10,
    "order": ["job_relevance", "evidence_strength", "quantified", "differentiation", "recognition"]
  },
  "excluded_reason_order": [
    "ENTRY_NOT_SELECTED",
    "UNSUPPORTED_FOR_ROLE",
    "REDUNDANT",
    "WEAKER_ALTERNATIVE",
    "LOW_RELEVANCE",
    "FUTURE_FACT_RESTRICTION",
    "SPACE_CONSTRAINT"
  ],
  "min_relevance_threshold": 0.0,
  "tiebreak": ["marginal_score", "phase3_score", "fact_status", "evidence_strength", "quantified", "fact_id"]
}