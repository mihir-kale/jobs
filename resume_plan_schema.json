{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumePlan",
  "description": "Deterministic output of the resume planner. Consumes a validated evidence_match object plus the canonical candidate evidence bank and produces a plan IR: selected entries, greedy-selected facts arranged into bullet slots with target competencies/terms, skill ordering, education details, coverage analysis, coverage-loss, exclusions with reason codes, warnings, and provenance. Contains only planning bookkeeping (IDs, scores, rationales); it never writes prose, never mutates evidence, and never assembles the renderer JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_for",
    "summary",
    "education",
    "experience",
    "leadership",
    "additional",
    "skills",
    "coverage",
    "excluded_evidence",
    "supporting_facts",
    "warnings",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_for": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "title", "program_term", "competency_map_schema_version"],
      "properties": {
        "company": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "program_term": { "type": ["string", "null"] },
        "competency_map_schema_version": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_experience_entries",
        "selected_leadership_entries",
        "bullet_slots",
        "competencies_covered_strong",
        "competencies_covered_moderate",
        "high_priority_supported_omitted",
        "unsupported_skills_excluded",
        "redundant_facts_rejected",
        "future_facts_selected"
      ],
      "properties": {
        "selected_experience_entries": { "type": "array", "items": { "type": "string" } },
        "selected_leadership_entries": { "type": "array", "items": { "type": "string" } },
        "bullet_slots": { "type": "integer", "minimum": 0 },
        "competencies_covered_strong": { "type": "array", "items": { "type": "string" } },
        "competencies_covered_moderate": { "type": "array", "items": { "type": "string" } },
        "high_priority_supported_omitted": { "type": "array", "items": { "type": "string" } },
        "unsupported_skills_excluded": { "type": "array", "items": { "type": "string" } },
        "redundant_facts_rejected": { "type": "array", "items": { "type": "string" } },
        "future_facts_selected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "education_id", "institution", "degree", "location", "date",
          "selected_detail_ids", "excluded_detail_ids", "selected_coursework_tags", "rationale"
        ],
        "properties": {
          "education_id": { "type": "string" },
          "institution": { "type": "string" },
          "degree": { "type": "string" },
          "location": { "type": "string" },
          "date": { "type": "string" },
          "selected_detail_ids": { "type": "array", "items": { "type": "string" } },
          "excluded_detail_ids": { "type": "array", "items": { "type": "string" } },
          "selected_coursework_tags": { "type": "array", "items": { "type": "string" } },
          "rationale": { "type": "string" }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry_plan" }
    },
    "leadership": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry_plan" }
    },
    "additional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_lines", "skills_line_skill_ids", "coursework_line_competency_ids"],
      "properties": {
        "budget_lines": { "type": "integer", "minimum": 1 },
        "skills_line_skill_ids": { "type": "array", "items": { "type": "string" } },
        "coursework_line_competency_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_skills", "excluded", "unsupported_requested"],
      "properties": {
        "selected_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id", "display_name", "category", "verified", "jd_level",
              "evidence_count", "selected_fact_support", "score", "rationale"
            ],
            "properties": {
              "skill_id": { "type": "string" },
              "display_name": { "type": "string" },
              "category": { "type": "string" },
              "verified": { "const": true },
              "jd_level": { "type": ["string", "null"] },
              "evidence_count": { "type": "integer", "minimum": 0 },
              "selected_fact_support": { "type": "boolean" },
              "score": { "type": "number" },
              "rationale": { "type": "string" }
            }
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill_id", "display_name", "reason"],
            "properties": {
              "skill_id": { "type": "string" },
              "display_name": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "unsupported_requested": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonical_term", "skill_id", "status"],
            "properties": {
              "canonical_term": { "type": "string" },
              "skill_id": { "type": ["string", "null"] },
              "status": { "enum": ["unsupported", "not_in_bank"] }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competencies", "candidate_possible", "selected", "coverage_loss", "_guard"],
      "properties": {
        "_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_weight", "candidate_min_level", "max_acceptable_selected_level"],
          "properties": {
            "min_weight": { "type": "number" },
            "candidate_min_level": { "type": "string" },
            "max_acceptable_selected_level": { "type": "string" }
          }
        },
        "competencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "competency_id", "rank", "weight", "target_level", "candidate_level",
              "candidate_best_fact_id", "selected_level", "selected_facts", "gap"
            ],
            "properties": {
              "competency_id": { "type": "string" },
              "rank": { "type": "integer" },
              "weight": { "type": "number" },
              "target_level": { "enum": ["strong", "moderate", "none"] },
              "candidate_level": { "enum": ["strong", "moderate", "weak", "none"] },
              "candidate_best_fact_id": { "type": ["string", "null"] },
              "selected_level": { "enum": ["strong", "moderate", "weak", "none"] },
              "selected_facts": { "type": "array", "items": { "type": "string" } },
              "gap": { "enum": ["unsupported", "under_selected", "none"] }
            }
          }
        },
        "candidate_possible": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strong", "moderate", "weak", "none"],
          "properties": {
            "strong": { "type": "array", "items": { "type": "string" } },
            "moderate": { "type": "array", "items": { "type": "string" } },
            "weak": { "type": "array", "items": { "type": "string" } },
            "none": { "type": "array", "items": { "type": "string" } }
          }
        },
        "selected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strong", "moderate", "weak", "none"],
          "properties": {
            "strong": { "type": "array", "items": { "type": "string" } },
            "moderate": { "type": "array", "items": { "type": "string" } },
            "weak": { "type": "array", "items": { "type": "string" } },
            "none": { "type": "array", "items": { "type": "string" } }
          }
        },
        "coverage_loss": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["competency_id", "rank", "weight", "candidate_level", "selected_level", "reason"],
            "properties": {
              "competency_id": { "type": "string" },
              "rank": { "type": "integer" },
              "weight": { "type": "number" },
              "candidate_level": { "type": "string" },
              "selected_level": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "excluded_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "entry_id", "reason", "explanation"],
        "properties": {
          "fact_id": { "type": "string" },
          "entry_id": { "type": "string" },
          "reason": { "enum": [
            "ENTRY_NOT_SELECTED", "REDUNDANT", "SPACE_CONSTRAINT", "LOW_RELEVANCE",
            "WEAKER_ALTERNATIVE", "UNSUPPORTED_FOR_ROLE", "FUTURE_FACT_RESTRICTION"
          ] },
          "explanation": { "type": "string" }
        }
      }
    },
    "supporting_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "primary_fact_id", "entry_id", "relation"],
        "properties": {
          "fact_id": { "type": "string" },
          "primary_fact_id": { "type": "string" },
          "entry_id": { "type": "string" },
          "relation": { "const": "recognition" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_version", "candidate_evidence_hash", "evidence_match_hash",
        "planner_config_hash", "plan_hash"
      ],
      "properties": {
        "planner_version": { "type": "string" },
        "candidate_evidence_hash": { "type": "string" },
        "evidence_match_hash": { "type": "string" },
        "planner_config_hash": { "type": "string" },
        "plan_hash": { "type": "string" }
      }
    }
  },
  "$defs": {
    "entry_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id", "section", "organization", "location", "title", "dates",
        "entry_status", "aggregate_relevance", "entry_score", "bullet_slots"
      ],
      "properties": {
        "entry_id": { "type": "string" },
        "section": { "enum": ["experience", "leadership", "activity", "other"] },
        "organization": { "type": "string" },
        "location": { "type": "string" },
        "title": { "type": "string" },
        "dates": { "type": "string" },
        "entry_status": { "enum": ["incoming", "current", "past"] },
        "aggregate_relevance": { "type": "number" },
        "entry_score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top_fact", "second_fact", "third_fact", "quality_bonus",
            "role_family_bonus", "unique_coverage_bonus", "total"
          ],
          "properties": {
            "top_fact": { "type": "number" },
            "second_fact": { "type": "number" },
            "third_fact": { "type": "number" },
            "quality_bonus": { "type": "number" },
            "role_family_bonus": { "type": "number" },
            "unique_coverage_bonus": { "type": "number" },
            "total": { "type": "number" }
          }
        },
        "bullet_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot_id", "priority", "primary_fact_id", "supporting_fact_ids",
              "primary_competency_ids", "secondary_competency_ids", "target_terms",
              "targeted_metrics", "marginal_score", "components", "rationale"
            ],
            "properties": {
              "slot_id": { "type": "string" },
              "priority": { "type": "integer", "minimum": 1 },
              "primary_fact_id": { "type": "string" },
              "supporting_fact_ids": { "type": "array", "items": { "type": "string" } },
              "primary_competency_ids": { "type": "array", "items": { "type": "string" } },
              "secondary_competency_ids": { "type": "array", "items": { "type": "string" } },
              "target_terms": { "type": "array", "items": { "type": "string" } },
              "targeted_metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["metric_id", "value", "status"],
                  "properties": {
                    "metric_id": { "type": "string" },
                    "value": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              },
              "marginal_score": { "type": "number" },
              "components": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "new_competency_coverage", "skill_support", "evidence_quality",
                  "metric_bonus", "differentiation", "redundancy_penalty", "section_prior"
                ],
                "properties": {
                  "new_competency_coverage": { "type": "number" },
                  "skill_support": { "type": "number" },
                  "evidence_quality": { "type": "number" },
                  "metric_bonus": { "type": "number" },
                  "differentiation": { "type": "number" },
                  "redundancy_penalty": { "type": "number" },
                  "section_prior": { "type": "number" }
                }
              },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    }
  }
}